# MongoDB Configuration
# Get your free MongoDB Atlas connection string from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/indomen?retryWrites=true&w=majority

# Or use local MongoDB for development
# MONGODB_URI=mongodb://localhost:27017/indomen

# Server Configuration
PORT=3000
NODE_ENV=development

# Session Secret
SESSION_SECRET=fresh-farm-secret-key-change-in-production

# Stripe API Keys (Optional)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# App URL
APP_URL=http://localhost:5173

# Email Configuration (Optional - for invitations)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

